PORT=5000
NODE_ENV=development

# MongoDB connection string (local mongod or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/sfms

# JWT
JWT_SECRET=change_me_to_a_long_random_string
# Session length is per role in server/src/utils/token.ts (superadmin 7d, admin 30d,
# teacher 180d, parent/student 365d) so the schools cannot drift apart on it.
# This value is only the fallback for a role missing from that table.
JWT_EXPIRE=7d

# Super admin auto-created on first server start
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@school.com
SUPERADMIN_PASSWORD=super123

# Frontend URL (CORS + email links)
CLIENT_URL=http://localhost:5173

# School name printed on receipts and used in emails. This is the BACKEND copy —
# keep it identical to VITE_SCHOOL_NAME in frontend/.env, because a receipt takes
# its heading from here and its address line from the frontend build. It also
# names the backup files, so give each school its own value.
SCHOOL_NAME=R K Public School

# Razorpay TEST keys (https://dashboard.razorpay.com -> Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Convenience fee for online payments from home, as a PERCENTAGE of the amount
# paid (counter/UPI-QR payments have no charge). Razorpay keeps 2% + 18% GST =
# 2.36% of the total, so 2.5% (rounded up to the rupee) covers the gateway cut on
# every payment and the school never runs at a loss.
ONLINE_PLATFORM_FEE_PCT=2.5
# School UPI ID + name for the counter QR (parents scan and pay, no gateway charge)
SCHOOL_UPI_VPA=school@upi
SCHOOL_UPI_NAME=School Fee Office

# Automatic late fee charged per day past an invoice's due date. Leave both at 0
# to switch the feature off; LATE_FEE_MAX=0 means "no cap".
LATE_FEE_PER_DAY=0
LATE_FEE_MAX=0

# Where the "Backup now" button writes its temporary dump before sending it to
# the browser (defaults to the OS temp dir if left blank). Requires the
# mongodb-database-tools package (mongodump) to be installed on the server.
BACKUP_DIR=

# "Back up to Google Drive" button: the rclone remote (and optional path) the
# archive is copied to, plus the rclone config to use when the server doesn't run
# as the user that holds it. Give each school its own folder. See
# GDRIVE_BACKUP_SETUP for connecting rclone to Drive.
BACKUP_REMOTE=gdrive:sfms-backups
RCLONE_CONFIG=

# Email (nodemailer) - optional, for receipt/reminder emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="School Fee System <no-reply@sfms.local>"
