# =============================================================================
# Frontend build-time config (Vite). Copy to `.env` and edit for this school:
#   cp .env.example .env
#
# IMPORTANT: these are read at BUILD time and baked into the static bundle.
# After changing any value, rebuild the frontend (npm run build / dev restart).
# Only variables prefixed with VITE_ are exposed to the app. `.env` is gitignored.
#
# Every value is OPTIONAL — anything left unset falls back to a sensible default
# in src/lib/school.ts, so the app still runs with nothing set here.
# =============================================================================

# ---- API (leave unset to use the same-origin /api via the dev proxy / Nginx) ----
# VITE_API_URL=/api

# ---- School identity / branding ----
VITE_SCHOOL_NAME=R K Public School
VITE_SCHOOL_PLACE=Garhwa
# Full name shown in the tab title, receipts, certificates. Defaults to "NAME, PLACE".
VITE_SCHOOL_FULL_NAME=R K Public School, Garhwa
# Short label / abbreviation used in tight spaces.
VITE_SCHOOL_SHORT_NAME=RKPS
# Two-letter monogram for the crest badge.
VITE_SCHOOL_MONOGRAM=RK
VITE_SCHOOL_TAGLINE=Nurturing knowledge, character & confidence.
VITE_SCHOOL_INTRO=A co-educational English-medium school offering quality education from Nursery to Class 12, with a focus on strong academics, values and all-round development.

# ---- People (appear on the home page, receipts and certificates) ----
VITE_SCHOOL_DIRECTOR_NAME=Mr. Alakh Nath Panday
VITE_SCHOOL_DIRECTOR_ROLE=Director
VITE_SCHOOL_PRINCIPAL_NAME=Mr. Santosh Panday
VITE_SCHOOL_PRINCIPAL_ROLE=Principal

# ---- Contact / details (blank ones are simply hidden — nothing fake is shown) ----
VITE_SCHOOL_ADDRESS=Garhwa, Jharkhand
VITE_SCHOOL_PHONE=
VITE_SCHOOL_EMAIL=
VITE_SCHOOL_ESTABLISHED=
# Board / affiliation (e.g. "Affiliated to CBSE" or "JAC").
VITE_SCHOOL_AFFILIATION=
