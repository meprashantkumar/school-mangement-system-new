# =============================================================================
# Config for the SHARED services (Caddy + Mongo). One of these per server.
# Copy to infra.env and fill in. infra.env holds secrets and is gitignored.
#
#   cp infra.env.example infra.env
#   docker compose --env-file infra.env -f docker-compose.infra.yml -p sfms_infra up -d
# =============================================================================

# Let's Encrypt account address — certificate expiry warnings are sent here.
ACME_EMAIL=you@example.com

# ---- Shared MongoDB ---------------------------------------------------------
# The root user of the one mongod. Every school's api connects with these, and
# each school gets its OWN database (DB_NAME in the school env file).
MONGO_USER=sfms_admin
MONGO_PASS=CHANGE_ME_STRONG          # openssl rand -hex 24

# WiredTiger cache cap in GB. Keep this small on a small box: it is the biggest
# single lever on Mongo's memory use. 0.25 suits a few hundred students per
# school; raise it to 1+ if the box has several GB spare.
MONGO_CACHE_GB=0.25
