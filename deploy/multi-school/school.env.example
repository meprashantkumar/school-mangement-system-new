# =============================================================================
# Config for ONE school. Copy it per school and fill in:
#
#   cp school.env.example school1.env
#   nano school1.env
#   docker compose --env-file school1.env -f docker-compose.school.yml \
#     -p sfms_school1 up -d --build
#
# These files hold secrets and are gitignored. Never commit a filled-in one.
# =============================================================================

# Short key for this school. Names the containers (school1-api, school1-web) and
# must match what the Caddyfile proxies to. Lowercase, no spaces.
SCHOOL_KEY=school1

# The school's public URL. Used for CORS and links in emails, so it must match
# the domain in the Caddyfile exactly, https included.
CLIENT_URL=https://school1.example.in

# ---- Database ---------------------------------------------------------------
# MUST be unique per school. Two schools sharing a DB_NAME share one set of
# students, silently, with no error to warn you.
DB_NAME=sfms_school1
# Same values as infra.env — it is one mongod, and these are its root creds.
MONGO_USER=sfms_admin
MONGO_PASS=SAME_AS_INFRA_ENV

# ---- Security ---------------------------------------------------------------
# Unique per school: openssl rand -hex 32
# Sharing one secret would let a token issued by one school be accepted by another.
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRE=7d

# Node heap cap in MB. 192 is comfortable for a school of a few hundred; raise
# it if the box has RAM to spare and you see the api restarting under load.
API_HEAP_MB=192
# Heap for the frontend build only (tsc + vite). Raise if a build is killed.
BUILD_HEAP=1024

# ---- Identity / branding ----------------------------------------------------
# Server-side name: emails, and the filename of every backup archive.
SCHOOL_NAME=Example Public School

# Compiled into the site at build time, so changes need --build to show up.
# Leave any of them blank to fall back to the defaults in src/lib/school.ts.
VITE_SCHOOL_NAME=Example Public School
VITE_SCHOOL_PLACE=Town
VITE_SCHOOL_FULL_NAME=Example Public School, Town
VITE_SCHOOL_SHORT_NAME=EPS
# Two letters. Also the letters on the installable app's home-screen icon.
VITE_SCHOOL_MONOGRAM=EP
VITE_SCHOOL_TAGLINE=Nurturing knowledge, character & confidence.
VITE_SCHOOL_INTRO=A co-educational English-medium school from Nursery to Class 12.
VITE_SCHOOL_DIRECTOR_NAME=
VITE_SCHOOL_DIRECTOR_ROLE=Director
VITE_SCHOOL_PRINCIPAL_NAME=
VITE_SCHOOL_PRINCIPAL_ROLE=Principal
VITE_SCHOOL_ADDRESS=
VITE_SCHOOL_PHONE=
VITE_SCHOOL_EMAIL=
VITE_SCHOOL_ESTABLISHED=
VITE_SCHOOL_AFFILIATION=

# ---- Seed super admin (created on first boot only) --------------------------
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@school1.example.in
SUPERADMIN_PASSWORD=CHANGE_ME_THEN_CHANGE_IN_APP

# ---- Fees and payments (each school uses its OWN accounts) ------------------
# Online payment is currently commented out in the parent portal, so these are
# unused until it is switched back on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ONLINE_PLATFORM_FEE_PCT=2.5
SCHOOL_UPI_VPA=
SCHOOL_UPI_NAME=School Fee Office
LATE_FEE_PER_DAY=0
LATE_FEE_MAX=0

# ---- Backups ----------------------------------------------------------------
# Its own Drive folder per school, so one school's restore cannot touch
# another's archives. Needs rclone/<SCHOOL_KEY>/rclone.conf to be set up first.
BACKUP_REMOTE=gdrive:sfms-backups-school1

# ---- Email (optional; leave blank to disable password-reset mail) -----------
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
