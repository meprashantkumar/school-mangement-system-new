# =============================================================================
# Per-school Docker config. Copy this to school1.env / school2.env and fill in.
# Run:  docker compose --env-file school1.env -p sfms_school1 up -d --build
#
# NOTE: keep these files private and OUT of git (they hold secrets). They are
# gitignored via *.env below-ignore rules — never commit real values.
# =============================================================================

# ---- Web ----
# Host port this school is served on (host Nginx routes the domain here).
WEB_PORT=8080
# Public URL of this school (used in emails + CORS).
CLIENT_URL=https://school1.mydomain.in

# ---- Database (self-hosted Mongo in the mongo container) ----
DB_NAME=sfms
MONGO_USER=sfms_admin
MONGO_PASS=CHANGE_ME_STRONG
# WiredTiger cache cap (GB). 1 is fine per school when co-locating several.
MONGO_CACHE_GB=1

# ---- Security (MUST be unique per school!) ----
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM
# Session length is per role in server/src/utils/token.ts (superadmin 7d, admin 30d,
# teacher 180d, parent/student 365d) so the schools cannot drift apart on it.
# This value is only the fallback for a role missing from that table.
JWT_EXPIRE=7d

# ---- Identity / branding ----
# Server-side name (used in emails etc.)
SCHOOL_NAME=R K Public School, Area-1

# Frontend branding — baked into the site at build time (needs --build to apply).
# Fill these with THIS school's details; anything left blank uses a default.
VITE_SCHOOL_NAME=R K Public School
VITE_SCHOOL_PLACE=Garhwa
VITE_SCHOOL_FULL_NAME=R K Public School, Garhwa
VITE_SCHOOL_SHORT_NAME=RKPS
VITE_SCHOOL_MONOGRAM=RK
VITE_SCHOOL_TAGLINE=Nurturing knowledge, character & confidence.
VITE_SCHOOL_INTRO=A co-educational English-medium school offering quality education from Nursery to Class 12.
VITE_SCHOOL_DIRECTOR_NAME=Mr. Alakh Nath Panday
VITE_SCHOOL_DIRECTOR_ROLE=Director
VITE_SCHOOL_PRINCIPAL_NAME=Mr. Santosh Panday
VITE_SCHOOL_PRINCIPAL_ROLE=Principal
VITE_SCHOOL_ADDRESS=Garhwa, Jharkhand
VITE_SCHOOL_PHONE=
VITE_SCHOOL_EMAIL=
VITE_SCHOOL_ESTABLISHED=
VITE_SCHOOL_AFFILIATION=

# ---- Seed super admin (created on first boot) ----
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@school1.example.com
SUPERADMIN_PASSWORD=CHANGE_ME_THEN_CHANGE_IN_APP

# ---- Payments (each school uses its OWN accounts) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ONLINE_PLATFORM_FEE_PCT=2.5
SCHOOL_UPI_VPA=
SCHOOL_UPI_NAME=School Fee Office
LATE_FEE_PER_DAY=0
LATE_FEE_MAX=0

# ---- Backups (own Google Drive folder per school) ----
BACKUP_REMOTE=gdrive:sfms-backups-school1

# ---- Email (optional) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=R K Public School <no-reply@school1.example.com>
