# =============================================================================
# Per-school Docker config. Copy this to school1.env / school2.env and fill in.
# Run:  docker compose --env-file school1.env -p sfms_school1 up -d --build
#
# NOTE: keep these files private and OUT of git (they hold secrets). They are
# gitignored via *.env below-ignore rules — never commit real values.
# =============================================================================

# ---- Web ----
# Host port this school is served on (host Nginx routes the domain here).
WEB_PORT=8080
# Public URL of this school (used in emails + CORS).
CLIENT_URL=https://school1.mydomain.in

# ---- Database (self-hosted Mongo in the mongo container) ----
DB_NAME=sfms
MONGO_USER=sfms_admin
MONGO_PASS=CHANGE_ME_STRONG
# WiredTiger cache cap (GB). 1 is fine per school when co-locating several.
MONGO_CACHE_GB=1

# ---- Security (MUST be unique per school!) ----
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRE=7d

# ---- Identity / branding ----
SCHOOL_NAME=R K Public School, Area-1

# ---- Seed super admin (created on first boot) ----
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@school1.example.com
SUPERADMIN_PASSWORD=CHANGE_ME_THEN_CHANGE_IN_APP

# ---- Payments (each school uses its OWN accounts) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ONLINE_PLATFORM_FEE_PCT=2.5
SCHOOL_UPI_VPA=
SCHOOL_UPI_NAME=School Fee Office
LATE_FEE_PER_DAY=0
LATE_FEE_MAX=0

# ---- Backups (own Google Drive folder per school) ----
BACKUP_REMOTE=gdrive:sfms-backups-school1

# ---- Email (optional) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=R K Public School <no-reply@school1.example.com>
